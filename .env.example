# Copy to .env and adjust.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# N-ATLaS gateway (N-ATLAS-Kit). Leave NATLAS_BASE_URL empty to run on Lafiya's
# grounded templates + browser speech. Examples:
#   Modal:  https://<workspace>--natlas-serve-natlasservice-serve.modal.run
#   Local:  http://localhost:8080
NATLAS_BASE_URL=
# One of the values you put in the gateway's NATLAS_API_KEYS (not your HF token)
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
# Seconds; requests that time out (e.g. during a cold start) fall back to templates
NATLAS_TIMEOUT=60

# 1 = fetch live weather from Open-Meteo (falls back to simulation if offline)
CLIMATE_LIVE_WEATHER=1

# Aggregated counts below this are suppressed in exports and the open API
ANON_MIN_CELL=5

# NAIC PS02: voice input only through the official N-ATLaS ASR (no browser fallback)
LAFIYA_CHALLENGE_MODE=0

# Spoken replies via the gateway voices; N-ATLaS-written daily alerts (off = saves GPU credit)
LAFIYA_SPOKEN_REPLIES=1
LAFIYA_NATLAS_FOR_ALERTS=0

# WhatsApp voice-note channel (Twilio). Webhook: <PUBLIC_BASE_URL>/whatsapp/twilio/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=1
# Public https URL of this server (cloudflared / ngrok tunnel or deployment)
PUBLIC_BASE_URL=
